# --- Fournisseur LLM : "openai", "gemini", "anthropic" ou "copilot" ---
LLM_PROVIDER=openai

# --- Gemini (Google AI Studio) ---
#GEMINI_API_KEY=sk-VOTRE_CLE_ICI
#GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic (optionnel) ---
# ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_ICI
# ANTHROPIC_MODEL=claude-opus-4-6

# --- GitHub Models / Copilot (optionnel) ---
GITHUB_TOKEN=ghp-VOTRE_CLE_ICI
COPILOT_MODEL=gpt-4o

# --- OpenAI (Standard) ---
OPENAI_API_KEY= sk-VOTRE_CLE_ICI
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
TELEGRAM_TOKEN=

# --- Langfuse (Observabilité — laisser vide pour désactiver) ---
# Créer un compte sur http://localhost:3000 après docker-compose -f docker-compose.langfuse.yml up -d
# Puis Settings > API Keys pour récupérer les clés
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3000
