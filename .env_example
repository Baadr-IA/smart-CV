# --- Fournisseur LLM : "openai", "gemini", "anthropic", "copilot" ou "local_openai" ---
LLM_PROVIDER=openai

# --- Gemini (Google AI Studio) ---
#GEMINI_API_KEY=sk-VOTRE_CLE_ICI
#GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic (optionnel) ---
# ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_ICI
# ANTHROPIC_MODEL=claude-opus-4-6

# --- GitHub Models / Copilot (optionnel) ---
GITHUB_TOKEN=ghp-VOTRE_CLE_ICI
COPILOT_MODEL=gpt-4o

# --- OpenAI (Standard) ---
OPENAI_API_KEY= sk-VOTRE_CLE_ICI
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# --- Endpoint OpenAI-compatible local (ex: vLLM / Qwen OCR) ---
# Utilise LLM_PROVIDER=local_openai si tu veux aussi l'utiliser pour les étapes texte.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=dummy
LOCAL_LLM_MODEL=qwen-cv

# --- Embeddings RAG ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=8
RERANKER_CANDIDATE_POOL=20
HYBRID_DENSE_CANDIDATE_POOL=30
HYBRID_LEXICAL_CANDIDATE_POOL=30
SQL_PREFILTER_CANDIDATE_POOL=120
HYBRID_RRF_K=60

# --- PostgreSQL / pgvector ---
# Local hors Docker :
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/smartcv
# Dans docker-compose, la valeur est surchargée vers le service `pgvector`.
PGVECTOR_TABLE_PREFIX=rag_vector

# --- Routage OCR PDF : pypdf -> tesseract -> qwen ---
PDF_PARSE_MODE=smart
OCR_PROVIDER=local_openai
OCR_ENABLE_LLM_FALLBACK=true
LLM_VISION_MODEL=qwen-cv
MIN_CHARS_PER_PAGE=30
OCR_MIN_CHARS=200
OCR_MIN_WORDS=40
OCR_MIN_ALPHA_RATIO=0.60
OCR_MIN_WORDS_PER_PAGE=20
OCR_MIN_ANCHOR_HITS=1
LOG_LEVEL=INFO
API_KEY_DISABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_TOKEN=

# --- Langfuse (Observabilité — laisser vide pour désactiver) ---
# Créer un compte sur http://localhost:3000 après docker-compose -f docker-compose.yml -f docker-compose.observability.yml up -d
# Puis Settings > API Keys pour récupérer les clés
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Grafana (optionnel) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
