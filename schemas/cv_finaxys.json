{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CVData",
  "type": "object",
  "additionalProperties": false,
  "required": ["identite", "metadata"],
  "properties": {
    "identite": { "$ref": "#/$defs/identite" },
    "titre_professionnel": { "type": ["string", "null"] },
    "type_poste": { "type": ["string", "null"] },
    "profil": { "type": ["string", "null"] },
    "competences": {
      "type": "array",
      "items": { "$ref": "#/$defs/competence" },
      "default": []
    },
    "experiences": {
      "type": "array",
      "items": { "$ref": "#/$defs/experience" },
      "default": []
    },
    "projets_academiques": {
      "type": "array",
      "items": { "$ref": "#/$defs/projet_academique" },
      "default": []
    },
    "formations": {
      "type": "array",
      "items": { "$ref": "#/$defs/formation" },
      "default": []
    },
    "certifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/certification" },
      "default": []
    },
    "langues": {
      "type": "array",
      "items": { "$ref": "#/$defs/langue" },
      "default": []
    },
    "centres_interet": { "type": ["string", "null"] },
    "metadata": { "$ref": "#/$defs/metadata" }
  },
  "$defs": {
    "year_month": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
    },
    "identite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nom"],
      "properties": {
        "nom": { "type": "string", "minLength": 1 },
        "prenom": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "localisation": { "type": ["string", "null"] },
        "telephone": { "type": ["string", "null"] },
        "linkedin": { "type": ["string", "null"] }
      }
    },
    "competence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nom"],
      "properties": {
        "nom": { "type": "string", "minLength": 1 },
        "categorie": { "type": ["string", "null"] },
        "niveau": { "type": ["string", "null"] },
        "annees_experience": { "type": ["number", "null"] },
        "aliases_experiences": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0
        },
        "justification": { "type": ["string", "null"] }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titre", "entreprise", "date_debut"],
      "properties": {
        "titre": { "type": "string", "minLength": 1 },
        "entreprise": { "type": "string", "minLength": 1 },
        "date_debut": { "$ref": "#/$defs/year_month" },
        "date_fin": {
          "anyOf": [
            { "$ref": "#/$defs/year_month" },
            { "type": "null" }
          ]
        },
        "en_cours": { "type": "boolean", "default": false },
        "projet": { "type": ["string", "null"] },
        "equipe": { "type": ["string", "integer", "null"] },
        "methodologie": { "type": ["string", "null"] },
        "missions": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "technologies": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "resultats": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0
        },
        "justification": { "type": ["string", "null"] }
      }
    },
    "projet_academique": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nom"],
      "properties": {
        "nom": { "type": "string", "minLength": 1 },
        "etablissement": { "type": ["string", "null"] },
        "equipe": { "type": ["string", "integer", "null"] },
        "duree": { "type": ["string", "null"] },
        "missions": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "technologies": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "formation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diplome"],
      "properties": {
        "diplome": { "type": "string", "minLength": 1 },
        "etablissement": { "type": ["string", "null"] },
        "annee": { "type": ["integer", "string", "null"] }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nom"],
      "properties": {
        "nom": { "type": "string", "minLength": 1 },
        "organisme": { "type": ["string", "null"] },
        "annee": { "type": ["integer", "string", "null"] },
        "score": { "type": ["string", "null"] }
      }
    },
    "langue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["langue", "niveau"],
      "properties": {
        "langue": { "type": "string", "minLength": 1 },
        "niveau": { "type": "string", "minLength": 1 },
        "certification": { "type": ["string", "null"] }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_extraction", "source_fichier"],
      "properties": {
        "date_extraction": { "type": "string", "format": "date-time" },
        "source_fichier": { "type": "string", "minLength": 1 },
        "fichier_word": { "type": ["string", "null"] },
        "score_completude": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0
        },
        "champs_incertains": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "version_pipeline": { "type": "string", "default": "1.1.0" },
        "char_count": { "type": ["integer", "null"], "minimum": 0 },
        "parsing_method": { "type": ["string", "null"] },
        "validation_report": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "word_path": { "type": ["string", "null"] },
        "word_filename": { "type": ["string", "null"] },
        "s3_result_key": { "type": ["string", "null"] },
        "s3_result_uri": { "type": ["string", "null"] },
        "s3_word_key": { "type": ["string", "null"] }
      }
    }
  }
}
